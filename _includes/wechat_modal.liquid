<div
  id="wechat-modal"
  class="wechat-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="wechat-modal-title"
  aria-hidden="true"
>
  <div class="wechat-modal__dialog" role="document">
    <button type="button" class="wechat-modal__close" aria-label="Close WeChat QR code">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
    <h2 id="wechat-modal-title">WeChat</h2>
    <img src="{{ '/assets/img/wechat-qr.jpg' | relative_url }}" alt="Xiwen's WeChat QR code">
    <p>Scan the QR code to add me on WeChat.</p>
  </div>
</div>
